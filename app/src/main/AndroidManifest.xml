<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Напоминания (Итерация 05b). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Обновление по кнопке (итерация 10): проверить и скачать APK, передать установщику Android. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Полоска напоминания поверх других приложений (T-69); включается переключателем в «Настройках». -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Озвучка плана дня (итерация 30): читает и при выключенном экране, как плеер. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Полоска напоминания: приложение не засыпает, пока она на экране (0.30.0). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Точное время: на Android 12 — без запроса у пользователя, с Android 13 — разрешение для приложений-напоминалок. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".TasksApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpleTasks">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Задача поверх рабочего стола (из виджета и уведомлений): своя задача Android, без «недавних». -->
        <activity
            android:name=".TaskPopupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.prostovasei.simpletasks.popup"
            android:theme="@style/Theme.SimpleTasks.Overlay"
            android:windowSoftInputMode="adjustResize" />

        <!-- Нажатия в строках списка виджета (итерация 42): невидимый переходник, закрывается до показа. -->
        <activity
            android:name=".widget.WidgetClickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.prostovasei.simpletasks.widgetclick"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Окно обновления поверх рабочего стола (кнопка в виджете): та же отдельная задача, без «недавних». -->
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.prostovasei.simpletasks.popup"
            android:theme="@style/Theme.SimpleTasks.Overlay" />

        <service
            android:name=".notifications.SpeechService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".notifications.PopupService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Reminder strip over other apps stays visible and animated until dismissed" />
        </service>

        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Виджет «Задачи» (Итерация 06). -->
        <receiver
            android:name=".widget.TasksWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <!-- Уведомления банка (#233): чтение уведомлений Яндекса о покупках; доступ выдаёт PM в настройках Android. -->
        <service
            android:name=".notifications.bank.BankNotificationListener"
            android:exported="true"
            android:label="@string/bank_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Кнопки «Записать» и «Пропустить» уведомления о покупке — только от самого приложения. -->
        <receiver
            android:name=".notifications.bank.BankPurchaseReceiver"
            android:exported="false" />

        <!-- Ответ установщика Android при обновлении приложения. -->
        <receiver
            android:name=".core.update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Нажатия в виджете (вкладки, галочка) и полночь — только от самого приложения. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SimpleTasks.Overlay">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity android:name=".widget.WidgetPopupActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="com.prostovasei.simpletasks.popup"
            android:theme="@style/Theme.SimpleTasks.Overlay" android:windowSoftInputMode="adjustResize" />
        <service android:name=".widget.WidgetFinanceService"
            android:exported="false" android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>

</manifest>
