<?xml version="1.0" encoding="utf-8"?>
<!-- Ячейка вида «Неделя» в виджете (итерация 45): тонкие линии сетки справа и снизу цвета divider. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="end" android:width="@dimen/widget_hairline">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_divider" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="@dimen/widget_hairline">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_divider" />
        </shape>
    </item>
</layer-list>
