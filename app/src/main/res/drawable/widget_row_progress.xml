<?xml version="1.0" encoding="utf-8"?>
<!-- Прогресс дня (итерация 42): серая дорожка divider, зелёная часть accent, скругление SM. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_divider" />
            <corners android:radius="@dimen/widget_radius_sm" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_now" />
                <corners android:radius="@dimen/widget_radius_sm" />
            </shape>
        </clip>
    </item>
</layer-list>
