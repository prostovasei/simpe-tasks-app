<?xml version="1.0" encoding="utf-8"?>
<!-- Время отметки «сейчас» на шкале дня виджета (итерация 20): часы системы, идут сами, без перерисовки виджета. -->
<TextClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_now_clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:format12Hour="HH:mm"
    android:format24Hour="HH:mm"
    android:maxLines="1"
    android:textColor="@color/widget_now"
    android:textSize="11sp"
    android:textStyle="bold" />
