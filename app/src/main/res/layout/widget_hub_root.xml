<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Главная» (#329, этап 2): сверху полоса лимита и счета, посередине новости 2 × 2 со стрелками ‹ ›
  (#336: новости над задачами; #350 — все блоки в 12dp от краёв, задачи на неделю; #352 — сверху 12, снизу градиент), внизу прокручиваемый список задач «Просрочено · Сегодня · Завтра», поверх — панель справа.
  #346: заголовков разделов нет; новости листаются касанием по краям.
  #340: после финансов — «Привычки ›» и до трёх плашек на сегодня (нажатие отмечает).
  #338: у разделов заголовки «Финансы ›», «Новости ›», «Задачи ›» (нажатие переключает виджет на раздел); задачи идут до низа под панель.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_task_root_bg"
    android:clipToOutline="true"
    tools:ignore="PrivateResource"
    tools:targetApi="31">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/widget_hub_edge"
        android:orientation="vertical">

        <TextView android:id="@+id/widget_hub_title_finance" style="@style/WidgetHubTitle" android:visibility="gone" android:text="@string/module_finance" />

        <LinearLayout
            android:id="@+id/widget_hub_finance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/widget_hub_inner"
            android:orientation="vertical" />

        <TextView android:id="@+id/widget_hub_title_habits" style="@style/WidgetHubTitle" android:text="@string/module_habits" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_hub_habits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/widget_hub_edge"
            android:paddingEnd="@dimen/widget_hub_edge"
            android:paddingTop="@dimen/widget_hub_section"
            android:visibility="gone" />

        <TextView android:id="@+id/widget_hub_title_news" style="@style/WidgetHubTitle" android:visibility="gone" android:text="@string/module_news" />

        <!-- #346 (выбор PM): без стрелок и точек; невидимые края 18 % слева и справа листают страницы. -->
        <FrameLayout
            android:id="@+id/widget_hub_news"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/widget_hub_edge"
            android:paddingTop="@dimen/widget_hub_section"
            android:paddingBottom="@dimen/widget_hub_section_tail">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/widget_hub_news_row1" android:layout_width="match_parent"
                    android:layout_height="58dp" android:orientation="horizontal" />
                <LinearLayout android:id="@+id/widget_hub_news_row2" android:layout_width="match_parent"
                    android:layout_height="58dp" android:layout_marginTop="6dp" android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="122dp" android:orientation="horizontal">
                <FrameLayout android:id="@+id/widget_hub_prev" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="18" android:contentDescription="@string/hub_news_prev" />
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="64" />
                <FrameLayout android:id="@+id/widget_hub_next" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="18" android:contentDescription="@string/hub_news_next" />
            </LinearLayout>
        </FrameLayout>

        <TextView android:id="@+id/widget_hub_title_tasks" style="@style/WidgetHubTitle" android:visibility="gone" android:text="@string/module_tasks" />

        <ListView
            android:id="@+id/widget_hub_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/widget_hub_inner"
            android:layout_marginEnd="@dimen/widget_hub_list_end"
            android:paddingBottom="@dimen/widget_bar_space"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadingEdgeLength="0dp"
            android:listSelector="@android:color/transparent"
            android:requiresFadingEdge="none"
            style="@style/Glance.AppWidget.List" />

        <TextView
            android:id="@+id/widget_hub_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/hub_no_tasks"
            android:textColor="@color/widget_flat_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- #352 (выбор PM): градиент 40 снизу — список уходит под панель плавно. -->
    <FrameLayout
        android:id="@+id/widget_hub_fade"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_hub_fade"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_hub_fade" />

    <FrameLayout
        android:id="@+id/widget_hub_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_bar"
        android:layout_gravity="bottom" />
</FrameLayout>
