<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Главная» (#329, этап 2): сверху полоса лимита и счета, посередине новости 2 × 2 со стрелками ‹ ›
  (#336: новости над задачами), внизу прокручиваемый список задач «Просрочено · Сегодня · Завтра», поверх — панель справа.
  #340: после финансов — «Привычки ›» и до трёх плашек на сегодня (нажатие отмечает).
  #338: у разделов заголовки «Финансы ›», «Новости ›», «Задачи ›» (нажатие переключает виджет на раздел); задачи идут до низа под панель.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_task_root_bg"
    android:clipToOutline="true"
    tools:ignore="PrivateResource"
    tools:targetApi="31">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView android:id="@+id/widget_hub_title_finance" style="@style/WidgetHubTitle" android:text="@string/module_finance" />

        <LinearLayout
            android:id="@+id/widget_hub_finance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView android:id="@+id/widget_hub_title_habits" style="@style/WidgetHubTitle" android:text="@string/module_habits" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_hub_habits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/widget_edge"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:visibility="gone" />

        <TextView android:id="@+id/widget_hub_title_news" style="@style/WidgetHubTitle" android:text="@string/module_news" />

        <LinearLayout
            android:id="@+id/widget_hub_news"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/widget_edge"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">

            <LinearLayout android:id="@+id/widget_hub_news_row1" android:layout_width="match_parent"
                android:layout_height="58dp" android:orientation="horizontal" />

            <LinearLayout android:id="@+id/widget_hub_news_row2" android:layout_width="match_parent"
                android:layout_height="58dp" android:layout_marginTop="6dp" android:orientation="horizontal" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
                android:gravity="center" android:orientation="horizontal">
                <ImageView android:id="@+id/widget_hub_prev" android:layout_width="40dp" android:layout_height="28dp"
                    android:scaleType="center" android:src="@drawable/ic_hub_prev"
                    android:contentDescription="@string/hub_news_prev" />
                <TextView android:id="@+id/widget_hub_dots" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:letterSpacing="0.3"
                    android:textColor="@color/widget_flat_text_secondary" android:textSize="10sp" />
                <ImageView android:id="@+id/widget_hub_next" android:layout_width="40dp" android:layout_height="28dp"
                    android:scaleType="center" android:src="@drawable/ic_hub_next"
                    android:contentDescription="@string/hub_news_next" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/widget_hub_title_tasks" style="@style/WidgetHubTitle" android:text="@string/module_tasks" />

        <ListView
            android:id="@+id/widget_hub_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/widget_list_edge"
            android:paddingBottom="@dimen/widget_bar_space"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadingEdgeLength="0dp"
            android:listSelector="@android:color/transparent"
            android:requiresFadingEdge="none"
            style="@style/Glance.AppWidget.List" />

        <TextView
            android:id="@+id/widget_hub_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/hub_no_tasks"
            android:textColor="@color/widget_flat_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_hub_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_bar"
        android:layout_gravity="bottom" />
</FrameLayout>
