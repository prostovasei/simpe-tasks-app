<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="28dp" android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/widget_edge">
    <LinearLayout android:id="@+id/widget_finance_total_group"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:gravity="start|center_vertical">
        <ImageView android:layout_width="14dp" android:layout_height="14dp"
            android:src="@drawable/ic_finance_receipt" android:tint="@color/widget_flat_text_secondary"
            android:contentDescription="Потрачено"/>
        <TextView android:id="@+id/widget_finance_total" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/widget_flat_text_primary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_finance_remaining_group"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:gravity="center|center_vertical">
        <ImageView android:layout_width="14dp" android:layout_height="14dp"
            android:src="@drawable/ic_finance_limit" android:tint="@color/widget_flat_text_secondary"
            android:contentDescription="Остаток до лимита"/>
        <TextView android:id="@+id/widget_finance_remaining" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/widget_flat_text_primary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_finance_estimate_group"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:gravity="end|center_vertical">
        <ImageView android:layout_width="14dp" android:layout_height="14dp"
            android:src="@drawable/ic_finance_forecast" android:tint="@color/widget_flat_text_secondary"
            android:contentDescription="Прогноз"/>
        <TextView android:id="@+id/widget_finance_estimate" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/widget_flat_text_primary" />
    </LinearLayout>
</LinearLayout>
