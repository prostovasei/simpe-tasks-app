<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка новости виджета «Главная» (#329): строка «09:05 · Футбол · Новое» и заголовок в две строки. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hub_card"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/widget_hub_card_bg"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">
    <TextView android:id="@+id/hub_card_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textSize="10sp"
        android:textColor="@color/widget_flat_text_secondary" />
    <TextView android:id="@+id/hub_card_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="2" android:ellipsize="end" android:textSize="12sp"
        android:textColor="@color/widget_flat_text_primary" />
</LinearLayout>
