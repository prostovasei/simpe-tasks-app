<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано design/tools/gen_widget_week.py (#313): неделя в ленте календаря — семь чисел. Не править руками. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
