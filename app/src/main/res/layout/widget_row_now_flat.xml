<?xml version="1.0" encoding="utf-8"?>
<!-- Отметка «сейчас» (итерация 42): зелёное время системы слева, точка на линии шкалы и линия до правого края. -->
<!-- Обёртка: корень строки списка Android растягивает, высоту держит вложенный элемент. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent,RtlSymmetry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_now_row"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/widget_list_edge">

        <FrameLayout
            android:layout_width="@dimen/widget_time"
            android:layout_height="match_parent">

            <TextClock
                android:id="@+id/now_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:maxLines="1"
                android:textColor="@color/widget_flat_now"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/now_fixed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:maxLines="1"
                android:textColor="@color/widget_flat_now"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="@dimen/widget_rail"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/now_line_top"
                    android:layout_width="@dimen/widget_hairline"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/widget_flat_divider" />

                <FrameLayout
                    android:id="@+id/now_line_bottom"
                    android:layout_width="@dimen/widget_hairline"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/widget_flat_divider" />
            </LinearLayout>

            <ImageView
                android:id="@+id/now_dot"
                android:layout_width="@dimen/widget_now_dot"
                android:layout_height="@dimen/widget_now_dot"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_dot"
                android:tint="@color/widget_flat_now" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/now_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/widget_hairline"
            android:layout_weight="1"
            android:background="@color/widget_flat_now" />
    </LinearLayout>
</FrameLayout>
