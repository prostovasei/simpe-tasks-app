<?xml version="1.0" encoding="utf-8"?>
<!-- Колонка времени строки задачи (итерация 42): по правому краю; конец периода — серым под началом. Без времени — пусто. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_time"
    android:layout_width="@dimen/widget_time"
    android:layout_height="match_parent"
    android:gravity="end|center_vertical"
    android:orientation="vertical">

    <TextView
        android:id="@+id/row_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_flat_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/row_time_gap"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_hairline"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_flat_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
