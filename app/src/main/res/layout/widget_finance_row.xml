<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="24dp" android:paddingStart="@dimen/widget_edge" android:paddingEnd="@dimen/widget_edge"
    android:gravity="center_vertical">
    <LinearLayout
        android:id="@+id/widget_finance_left_column"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingEnd="@dimen/widget_edge">
        <TextView
            android:id="@+id/widget_finance_left"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_finance_left_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_finance_right_column"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingEnd="@dimen/widget_edge">
        <TextView
            android:id="@+id/widget_finance_right"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_finance_right_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
