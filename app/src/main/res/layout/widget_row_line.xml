<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка задачи виджета (#334, выбор PM 25.11.2026): кружок 18 → эмодзи списка 16 → название 14 sp полужирное → колокольчик 14 → время 13 sp.
  Одна разметка для всех лент (обычная и выполненная, «Все» и «Входящие»): цвета, рисунок кружка и видимость пишутся у каждой строки,
  лаунчер перекрашивает уже показанные строки. Нажатие на кружок — отметка, на остальную строку — открыть задачу.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_row"
    android:minHeight="@dimen/widget_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="@dimen/widget_list_edge">

    <FrameLayout
        android:id="@+id/row_check"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/widget_edge"
        android:paddingEnd="@dimen/widget_task_check_gap">

        <FrameLayout
            android:layout_width="@dimen/widget_task_check"
            android:layout_height="@dimen/widget_task_check"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/row_node"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_widget_node_ring" />

            <ImageView
                android:id="@+id/row_node_check"
                android:layout_width="@dimen/widget_node_check"
                android:layout_height="@dimen/widget_node_check"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_node_check"
                android:tint="@android:color/white"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/row_plaque"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/row_emoji"
            android:layout_width="@dimen/widget_task_emoji"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/widget_task_emoji_gap"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_600"
            android:maxLines="1"
            android:textColor="@color/widget_flat_text_primary"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/row_bell"
            android:layout_width="@dimen/widget_task_bell"
            android:layout_height="@dimen/widget_task_bell"
            android:layout_marginStart="@dimen/widget_task_right_gap"
            android:visibility="gone">

            <ImageView
                android:id="@+id/row_bell_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:tint="@color/widget_flat_text_secondary" />

            <ImageView
                android:id="@+id/row_bell_early"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:tint="@color/widget_flat_now"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_task_right_gap"
            android:fontFamily="@font/manrope_500"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
