<?xml version="1.0" encoding="utf-8"?>
<!--
  Выполненная задача (0.42.2): кружок залит, белая галочка, подпись «Снять отметку», плашка бледнее — прямо в разметке.
  Строка шкалы дня (итерация 42, обычные элементы Android вместо Glance): время | линия с кружком приоритета | плашка.
  Нажатие на время и кружок — «выполнено» (у выполненной — вернуть).
-->
<!-- Обёртка: корень строки списка Android растягивает, высоту держит вложенный элемент. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent,RtlSymmetry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_edge" android:paddingEnd="@dimen/widget_list_edge">

        <LinearLayout
            android:id="@+id/row_check"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <include layout="@layout/widget_row_time_flat" />

            <LinearLayout
                android:id="@+id/row_rail" android:layout_marginStart="@dimen/widget_week_content_gap" android:layout_width="@dimen/widget_week_check"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/row_line_top"
                    android:layout_width="@dimen/widget_hairline"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/widget_flat_divider" />

                <FrameLayout
                    android:layout_width="@dimen/widget_week_check"
                    android:layout_height="@dimen/widget_week_check">

                    <ImageView
                        android:id="@+id/row_node"
                        android:contentDescription="@string/task_uncomplete"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_widget_node_fill"
                        android:tint="@color/widget_flat_ring_none" />

                    <ImageView
                        android:id="@+id/row_node_check"
                        android:layout_width="@dimen/widget_week_tick"
                        android:layout_height="@dimen/widget_week_tick"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_node_check"
                        android:tint="@color/widget_task_surface" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/row_line_bottom"
                    android:layout_width="@dimen/widget_hairline"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/widget_flat_divider" />
            </LinearLayout>
        </LinearLayout>

        <include layout="@layout/widget_row_plaque_done_flat" />
    </LinearLayout>
</FrameLayout>
