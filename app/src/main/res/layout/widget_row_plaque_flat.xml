<?xml version="1.0" encoding="utf-8"?>
<!--
  Белая плашка задачи (итерация 42): название и значки справа налево — эмодзи списка, колокольчик (повтор — знаком на шкале, итерация 47).
  Нажатие — открыть задачу поверх рабочего стола.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:paddingTop="@dimen/widget_card_inset"
    android:paddingBottom="@dimen/widget_card_inset">

    <LinearLayout
        android:id="@+id/row_plaque"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_check_gap"
        android:paddingEnd="@dimen/widget_space_sm">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_flat_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/row_bell"
            android:layout_width="@dimen/widget_reminder_icon"
            android:layout_height="@dimen/widget_reminder_icon"
            android:layout_marginStart="@dimen/widget_space_xxs"
            android:visibility="gone">

            <ImageView
                android:id="@+id/row_bell_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:tint="@color/widget_flat_text_secondary" />

            <ImageView
                android:id="@+id/row_bell_early"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:tint="@color/widget_flat_now"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Эмодзи списка вместо цветного квадратика со значком (итерация 47). -->

        <TextView

            android:id="@+id/row_emoji"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginStart="@dimen/widget_space_xs"

            android:importantForAccessibility="no"

            android:maxLines="1"

            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
