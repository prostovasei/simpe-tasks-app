<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Переопределение стиля списка Glance (в библиотеке он пустой; на него ссылаются все разметки glance_list*):
      своя тонкая полоска прокрутки у самого правого края виджета, как в TickTick (доработка 0.19.4).
      Без этого система рисует свою полоску с отступом от края — она ложится на плашки.
      При обновлении Glance проверить, что разметки списка по-прежнему используют этот стиль (тест WidgetListStyleTest).
    -->
    <style name="Glance.AppWidget.List" parent="">
        <item name="android:scrollbars">vertical</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
        <item name="android:scrollbarSize">3dp</item>
        <item name="android:scrollbarThumbVertical">@drawable/widget_scroll_thumb</item>
        <item name="android:scrollbarTrackVertical">@null</item>
    </style>
</resources>
