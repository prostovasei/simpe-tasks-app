<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тема окна до старта Compose. Цвета интерфейса задаёт AppTheme. -->
    <!-- Без анимаций открытия и закрытия окон (решение PM: всё мгновенно). -->
    <style name="Theme.SimpleTasks" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Окна поверх рабочего стола (выбор списка виджета, задача из виджета или уведомления): прозрачный фон. -->
    <style name="Theme.SimpleTasks.Overlay">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- Окно задачи анимирует себя само (выезд снизу или рост из плашки виджета, 0.29) — без системной анимации. -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
